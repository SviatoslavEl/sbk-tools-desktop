{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "СБК Инструменты",
  "version": "2.5.2",
  "identifier": "ru.sbk.tools",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "СБК Инструменты",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/sbk-scanner-worker"],
    "resources": {
      "runtime-resources/": "scanner-runtime/",
      "../LICENSE": "licenses/LICENSE",
      "../THIRD_PARTY_LICENSES.md": "licenses/THIRD_PARTY_LICENSES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
