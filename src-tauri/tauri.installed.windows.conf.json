{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "СБК Инструменты — быстрый запуск",
  "mainBinaryName": "SBK-Tools-Fast",
  "identifier": "ru.sbk.tools.fast",
  "app": {
    "windows": [
      {
        "title": "СБК Инструменты — быстрый запуск",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 720
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "licenseFile": "../LICENSE",
    "shortDescription": "Быстро запускаемая установленная версия СБК Инструменты",
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "fixedRuntime",
        "path": "./webview2-runtime/Microsoft.WebView2.FixedVersionRuntime.151.0.4129.107.x64"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": false,
        "compression": "none",
        "startMenuFolder": "СБК Инструменты"
      }
    }
  }
}
